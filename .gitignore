.npmrc


# Relocatable static viewer build.
apps/web/dist-portable/

# Local review backups; never ship archived working copies.
.okie-review/

# Per-orb portal metadata is not repository configuration.
.amp/portals/*

# CLA-289 cross-repo eval: the live-run spend lock (held only while a --live process runs).
fixtures/cross-repo-eval/spend.json.lock
# QA evidence screenshots live on the qa-screenshots release, not in git history.
docs/qa/**/*.png
docs/qa/**/*.jpg
docs/qa/**/*.jpeg
docs/qa/**/*.webp
docs/qa/**/*.gif
docs/qa/**/*.mp4
docs/qa/**/*.webm

# Local index.json backups written by `publish:atlas --backfill-names|--backfill-meta` (CLA-269).
backfill-backup-*.json

# Local byte-pinned browser performance data; restore via pnpm perf:acquire.
fixtures/performance/data/
