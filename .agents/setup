#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Keep native builds within the intended 1 CPU / 2 GB tiny orb budget.
export CARGO_BUILD_JOBS=1
export CMAKE_BUILD_PARALLEL_LEVEL=1
export BINARYEN_CORES=1

step() {
  local started=$SECONDS
  printf '\n==> %s\n' "$*"
  "$@"
  printf '==> Finished in %ss\n' "$((SECONDS - started))"
}

# Match CI's Node 22 LTS; newer base-image Node versions change browser globals
# used by happy-dom tests. Pin the patch rather than following a moving LTS tag.
export PATH="$HOME/.local/share/atlas/node/bin:$PATH"
if [[ "$(node --version)" != 'v22.23.3' ]]; then
  step npm install --global --prefix "$HOME/.local/share/atlas/node" node@22.23.3
  hash -r
fi
marker='# Atlas orb Node LTS'
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
  printf '\n%s\nexport PATH="$HOME/.local/share/atlas/node/bin:$PATH"\n' "$marker" >> "$HOME/.bash_profile"
fi
missing=()
for package in build-essential pkg-config libssl-dev ca-certificates curl; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
    missing+=("$package")
  fi
done
if ((${#missing[@]})); then
  step sudo apt-get update -qq
  step sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing[@]}"
fi

pnpm_version=$(node -p 'require("./package.json").packageManager.split("@")[1]')
if ! command -v pnpm >/dev/null || [[ "$(pnpm --version)" != "$pnpm_version" ]]; then
  step npm install --global "pnpm@$pnpm_version"
fi

export PATH="$HOME/.cargo/bin:$PATH"
if ! command -v rustup >/dev/null; then
  installer=$(mktemp)
  trap 'rm -f "$installer"' EXIT
  step curl --fail --silent --show-error --location https://sh.rustup.rs -o "$installer"
  step sh "$installer" -y --profile minimal --default-toolchain none --no-modify-path
fi
# Keep Rust available to subsequent agents and supervised services, not only setup.
marker='# Okie orb Rust toolchain'
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
  printf '\n%s\nexport PATH="$HOME/.cargo/bin:$PATH"\n' "$marker" >> "$HOME/.bash_profile"
fi
# Tests running Rust analysis reject /tmp's world-writable ancestry. Keep their
# scratch directory outside the Cargo workspace, owned by this user.
orb_tmp="$HOME/.cache/atlas/tmp"
install -d -m 700 "$orb_tmp"
export TMPDIR="$orb_tmp"
marker='# Atlas orb resource limits and private test scratch'
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
  printf '\n%s\nexport CARGO_BUILD_JOBS=1 CMAKE_BUILD_PARALLEL_LEVEL=1 BINARYEN_CORES=1\nexport TMPDIR="$HOME/.cache/atlas/tmp"\n' "$marker" >> "$HOME/.bash_profile"
fi
# rustup reads the version, components, and target from rust-toolchain.toml.
step rustup show active-toolchain
# The scan tests need these additional components, matching CI.
step rustup component add rust-analyzer rust-src
if ! command -v wasm-pack >/dev/null || [[ "$(wasm-pack --version)" != 'wasm-pack 0.13.1' ]]; then
  step npm install --global wasm-pack@0.13.1
fi

step pnpm install --frozen-lockfile
# A stale orb snapshot may contain native addons built by an older Node ABI.
step pnpm rebuild tree-sitter tree-sitter-rust
step cargo fetch --locked
# Workspace consumers resolve emitted dist files, even during typechecking.
step pnpm --workspace-concurrency=1 -r --if-present --filter './packages/**' --filter './apps/server' build
step pnpm prepare:generated
