{
  "name": "okie",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm prepare:generated:release && pnpm -r --if-present build",
    "check": "pnpm prepare:generated && pnpm -r --if-present check",
    "dev": "pnpm prepare:generated && pnpm --filter @okie/web dev",
    "test": "pnpm -r --if-present test",
    "generate:fixtures": "pnpm --filter @okie/scene-compiler generate:fixtures",
    "generate:stress": "node scripts/generate-stress.mjs",
    "generate:wasm": "node scripts/build-wasm.mjs",
    "generate:wasm:debug": "node scripts/build-wasm.mjs --debug",
    "generate:wasm:release": "node scripts/build-wasm.mjs --release",
    "prepare:generated": "pnpm generate:stress && pnpm generate:wasm",
    "prepare:generated:release": "pnpm generate:stress && pnpm generate:wasm:release",
    "package:cli": "node scripts/package-scan.mjs",
    "publish:atlas": "node scripts/publish-atlas.mjs",
    "build:portable": "pnpm build && node scripts/build-portable-viewer.mjs",
    "eval:atlas": "node --test scripts/atlas-planning-audit.test.mjs && node scripts/atlas-planning-audit.mjs",
    "perf:acquire": "node scripts/performance/acquire.mjs",
    "perf:browser": "node scripts/performance/run.mjs",
    "perf:test": "node --test scripts/performance/common.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "0.25.12",
    "playwright": "1.58.2",
    "typescript": "^5.8.3"
  }
}
