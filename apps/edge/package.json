{
  "name": "@okie/edge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc --noEmit -p tsconfig.json && wrangler deploy --dry-run --containers-rollout=none --env='' --outdir dist",
    "dev": "wrangler dev --env='' --port 4196 --ip 127.0.0.1 --enable-containers=false",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "deploy:production": "node scripts/deploy.mjs production",
    "smoke:staging": "node scripts/smoke.mjs staging",
    "smoke:production": "node scripts/smoke.mjs production",
    "users:export": "node scripts/users.mjs export",
    "users:delete": "node scripts/users.mjs delete",
    "requests:export": "node scripts/users.mjs requests",
    "requests:status": "node scripts/users.mjs request-status"
  },
  "devDependencies": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/vitest-plugin": "1.2.1",
    "@cloudflare/workers-types": "5.20260921.1",
    "@okie/web": "workspace:*",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "~4.1.0",
    "wrangler": "4.136.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@okie/architecture": "workspace:*",
    "@streamparser/json": "^0.0.26"
  }
}
