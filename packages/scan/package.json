{
  "name": "@okie/scan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "okie-scan": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "enrichment-prompt.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/*.test.js",
    "scan": "pnpm build && node dist/cli.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@okie/architecture": "workspace:*",
    "@okie/scene-compiler": "workspace:*",
    "@scip-code/scip": "0.10.0",
    "semver": "7.8.5",
    "tree-sitter": "^0.22.4",
    "tree-sitter-rust": "^0.24.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/semver": "^7.8.0"
  }
}
